# Copie para .env e preencha. O .env e ignorado pelo git.

# Supabase: URL do projeto e chave de servico (usada pelo pipeline)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# ID da planilha do Google Sheets (o trecho da URL entre /d/ e /edit)
SHEET_ID=

# Credencial da conta de servico do Google, o JSON inteiro em uma linha
GOOGLE_CREDENTIALS=

# Anonimização da base de demonstração (demo/gerar_dados_demo.py).
# O script recusa rodar sem os três. Nao commite os valores que voce usar:
# publicados, eles tornam a anonimizacao reversivel.
DEMO_SEMENTE=
DEMO_ESCALA=
DEMO_VARIACAO=
