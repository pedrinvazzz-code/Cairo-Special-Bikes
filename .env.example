# Copie para .env e preencha. O .env e ignorado pelo git.

# Supabase: URL do projeto e chave de servico (usada pelo pipeline)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# ID da planilha do Google Sheets (o trecho da URL entre /d/ e /edit)
SHEET_ID=

# Credencial da conta de servico do Google, o JSON inteiro em uma linha
GOOGLE_CREDENTIALS=
